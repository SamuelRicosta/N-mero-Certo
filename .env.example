# Copie para .env.local (para rodar localmente com `vercel dev`)
# ou cadastre em Vercel > Project > Settings > Environment Variables.

# Preenchida automaticamente ao conectar o Neon pelo Marketplace da Vercel.
DATABASE_URL=postgres://usuario:senha@host.neon.tech/neondb?sslmode=require

# Login único do sistema.
APP_USER=admin
APP_PASSWORD=troque-esta-senha

# Texto aleatório longo (ex.: gere com `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`).
SESSION_SECRET=coloque-aqui-um-texto-aleatorio-longo
